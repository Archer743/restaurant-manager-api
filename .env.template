# =================================================================
# Database Config

POSTGRES_DB=<pg_db>
POSTGRES_PORT=<pg_port>
POSTGRES_USER=<pg_user>
POSTGRES_PASSWORD=<pg_password>


# =================================================================
# JWT Config

JWT_ISSUER=<issuer>
JWT_AUDIENCE=<audience>

# Secret key used for signing access tokens — must be long and random
JWT_SERVER_SECRET_KEY=<server_secret_key>

# Access token lifetime in HH:MM:SS format
JWT_ACCESS_TOKEN_LIFETIME=00:00:00


# =================================================================
# Session Config

# The length of the generated refresh token (integer)
SESSION_REFRESH_TOKEN_LENGTH=0

# Used for hashing refresh tokens — separate from JWT key
SESSION_SERVER_SECRET_KEY=<server_secret_key>

# Session lifetime in HH:MM:SS format
SESSION_LIFETIME=00:00:00

# For how many days to retain inactive sessions
SESSION_RETENTION_DAYS=0


# =================================================================
# Reservation Cleanup Config

# For how many months to retain reservations
RESERVATION_RETENTION_MONTHS=0


# =================================================================
# Launch Config

API_PORT=<api_port>

# ASP.NET Core environment - Development/Staging/Production
ASPNETCORE_ENVIRONMENT=<aspnetcore_env>

ASPNETCORE_ALLOWED_HOSTS=<allowed_hosts>


# =================================================================
# Logging Config

LOGGING_LOG_LEVEL_DEFAULT=<log_level_default>

LOGGING_LOG_LEVEL_MICROSOFT_ASPNETCORE=<log_level_aspnetcore>
